
const express = require("express");
const cors = require("cors");
const helmet = require("helmet");
const rateLimit = require("express-rate-limit");
const dns = require("node:dns").promises;
const https = require("node:https");
const ipaddr = require("ipaddr.js");

const app = express();

app.use(helmet());
app.use(cors());
app.use(express.json({ limit: "10kb" }));

app.use("/api", rateLimit({
  windowMs: 60000,
  limit: 10
}));

function validDomain(domain) {
  return typeof domain === "string" &&
    domain.length <= 253 &&
    /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i.test(domain);
}

function isPublicAddress(address) {
  try {
    return ipaddr.parse(address).range() === "unicast";
  } catch {
    return false;
  }
}

async function getPublicAddresses(domain) {
  const addresses = await dns.lookup(domain, {
    all: true,
    verbatim: true
  });

  if (!addresses.length ||
      addresses.some(item => !isPublicAddress(item.address))) {
    throw new Error("Domain has no safe public IP address.");
  }

  return addresses;
}

function checkHttps(domain, address) {
  return new Promise((resolve, reject) => {
    const pinnedLookup = (hostname, options, callback) => {
      if (typeof options === "function") callback = options;
      callback(null, address.address, address.family);
    };

    const request = https.request({
      hostname: domain,
      servername: domain,
      method: "HEAD",
      path: "/",
      lookup: pinnedLookup,
      timeout: 12000,
      headers: {
        "User-Agent": "Humphreyrich-Cyber-Defence/5.0"
      }
    }, response => {
      const certificate = response.socket.getPeerCertificate();

      resolve({
        statusCode: response.statusCode,
        headers: response.headers,
        certificate: {
          subject: certificate.subject?.CN || "Not supplied",
          issuer: certificate.issuer?.O ||
            certificate.issuer?.CN || "Not supplied",
          validTo: certificate.valid_to || "Not supplied"
        }
      });

      response.resume();
    });

    request.on("timeout", () =>
      request.destroy(new Error("HTTPS request timed out."))
    );

    request.on("error", reject);
    request.end();
  });
}

async function getDnsRecords(domain) {
  const types = ["A", "AAAA", "MX", "NS", "TXT"];
  const records = {};

  await Promise.all(types.map(async type => {
    try {
      records[type] = await dns[`resolve${type}`](domain);
    } catch {
      records[type] = [];
    }
  }));

  return records;
}

app.get("/health", (req, res) => {
  res.json({
    service: "Humphreyrich Cyber Defence",
    version: "5.0",
    status: "online"
  });
});

app.post("/api/scan", async (req, res) => {
  const domain = String(req.body.domain || "")
    .trim()
    .toLowerCase()
    .replace(/\.$/, "");

  if (!validDomain(domain)) {
    return res.status(400).json({
      error: "Enter a valid domain."
    });
  }

  try {
    const addresses = await getPublicAddresses(domain);
    const dnsRecords = await getDnsRecords(domain);

    const results = [];
    const findings = [];

    results.push({
      title: "DNS records",
      status: "CHECKED",
      type: "pass",
      details: JSON.stringify(dnsRecords)
    });

    try {
      const data = await checkHttps(domain, addresses[0]);

      results.push({
        title: "HTTPS connection",
        status: "CONNECTED",
        type: "pass",
        details: `HTTP status: ${data.statusCode}`
      });

      const expiry = Date.parse(data.certificate.validTo);
      const daysLeft = Math.floor(
        (expiry - Date.now()) / 86400000
      );

      if (!Number.isNaN(expiry) && daysLeft < 30) {
        findings.push("Certificate expires in fewer than 30 days.");
        results.push({
          title: "Certificate expiry",
          status: "WARNING",
          type: "warning",
          details: data.certificate.validTo
        });
      } else {
        results.push({
          title: "TLS certificate",
          status: "REVIEWED",
          type: "pass",
          details: `Subject: ${data.certificate.subject}; Issuer: ${data.certificate.issuer}; Expiry: ${data.certificate.validTo}`
        });
      }

      const headers = data.headers;

      const checks = [
        ["Strict-Transport-Security", "strict-transport-security"],
        ["Content-Security-Policy", "content-security-policy"],
        ["X-Content-Type-Options", "x-content-type-options"],
        ["Referrer-Policy", "referrer-policy"]
      ];

      for (const [name, key] of checks) {
        if (headers[key]) {
          results.push({
            title: name,
            status: "PRESENT",
            type: "pass",
            details: String(headers[key])
          });
        } else {
          findings.push(`${name} header not detected.`);
          results.push({
            title: name,
            status: "NOT DETECTED",
            type: "warning",
            details: "Review whether this security header is appropriate for the website."
          });
        }
      }

      const frameProtection =
        headers["x-frame-options"] ||
        String(headers["content-security-policy"] || "")
          .includes("frame-ancestors");

      results.push({
        title: "Clickjacking protection",
        status: frameProtection ? "DETECTED" : "NOT DETECTED",
        type: frameProtection ? "pass" : "warning",
        details: frameProtection
          ? "A common frame protection setting was detected."
          : "No common frame protection setting was detected."
      });

      if (!frameProtection) {
        findings.push("Frame protection was not detected.");
      }

    } catch (error) {
      findings.push("HTTPS inspection was not completed.");
      results.push({
        title: "HTTPS inspection",
        status: "NOT COMPLETED",
        type: "error",
        details: error.message
      });
    }

    res.json({
      domain,
      scannedAt: new Date().toISOString(),
      addresses: addresses.map(item => item.address),
      results,
      findings
    });

  } catch (error) {
    res.status(400).json({
      error: error.message || "Assessment failed."
    });
  }
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, "0.0.0.0", () => {
  console.log("Humphreyrich Cyber Defence v5.0 is running.");
});
